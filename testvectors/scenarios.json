     "expect": {
      "A": [
       "A_NONE",
       0,
       0,
       "none",
       "death-window"
      ],
      "B": [
       "B_NONE",
       0,
       0,
       "none",
       "init"
      ],
      "log": "A",
      "dispatch": "A"
     },
