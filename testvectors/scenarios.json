{
 "_note": "黄金测试向量。引擎是纯函数，可用本文件做完整回归，无需启动游戏、无需设备。",
 "_format": {
  "step.tick": "单调毫秒",
  "step.sample": "对 defaults.sample 的部分覆盖（未列出的字段沿用上一次的值）",
  "step.limits": "对当前用户上限的部分覆盖（持续生效直到再次改变）",
  "step.config": "对条目配置的部分覆盖，字段为 { item, slot?, intensity }",
  "step.switchB / step.estop": "开关与急停的电平",
  "expect.A / expect.B": "[slot, cfg, eff, clamp, reason]，clamp 为 'none' | 'out:NN' | 'abs:NN'；null 表示本帧无变化（不记录、不下发）",
  "expect.log / expect.dispatch": "本帧发生记录/下发的通道，取值 'A' | 'B' | 'AB' | ''",
  "expect.extra": "附加断言信息（如 pulse-end 的 n 与 Δtotal、E 的 dur）"
 },
 "defaults": {
  "sample": {
   "readOk": true,
   "epoch": 1,
   "inTitan": true,
   "alive": true,
   "health": 5000,
   "maxHealth": 5000,
   "doomed": false,
   "m25": false
  },
  "limits": {
   "aOut": null,
   "aAbs": null,
   "bOut": null,
   "bAbs": null
  },
  "switchB": true,
  "estop": false,
  "config": {
   "A_70": 20,
   "A_50": 30,
   "A_30": 40,
   "A_DOOM": 60,
   "B_HIT": 25,
   "E_DEATH": 45,
   "B_durationMs": 300,
   "B_refractoryMs": 200,
   "E_durationMs": 5000,
   "hysteresisPct": 2,
   "deathWindowCeilingMs": 8000,
   "inTitanFalseHoldMs": 500
  },
  "_initRule": "整个会话的第一帧，两通道的 reason 一律为 'init'（启动基准行），不论 slot 是什么"
 },
 "scenarios": [
  {
   "id": "S1-tier-progression-and-hits",
   "note": "档位递进（>70% → 70 → 50 → 30 → 濒死）、受击脉冲、不应期合并、脉冲自然结束",
   "steps": [
    {
     "tick": 0,
     "sample": {
      "health": 3400
     },
     "expect": {
      "A": [
       "A_70",
       20,
       20,
       "none",
       "init"
      ],
      "B": [
       "B_NONE",
       0,
       0,
       "none",
       "init"
      ],
      "log": "AB",
      "dispatch": "AB"
     },
     "note_log": "① 泰坦血量 3400/5000（68%）：A 通道进入 70% 档，持续输出"
    },
    {
     "tick": 100,
     "sample": {
      "health": 3000
     },
     "expect": {
      "A": null,
      "B": [
       "B_HIT",
       25,
       25,
       "none",
       "hit"
      ],
      "log": "B",
      "dispatch": "B"
     },
     "note_log": "② 受到一次攻击：B 通道给一次受击脉冲"
    },
    {
     "tick": 140,
     "sample": {
      "health": 2900
     },
     "expect": {
      "A": null,
      "B": null,
      "log": "",
      "dispatch": ""
     },
     "note": "Δ=100，距上次命中 40ms，在 200ms 不应期内 → 合并，不产生新脉冲"
    },
    {
     "tick": 400,
     "sample": {
      "health": 2900
     },
     "expect": {
      "A": null,
      "B": [
       "B_NONE",
       0,
       0,
       "none",
       "pulse-end"
      ],
      "log": "B",
      "dispatch": "B",
      "extra": {
       "n": 2,
       "dt": 500
      }
     }
    },
    {
     "tick": 500,
     "sample": {
      "health": 2400
     },
     "expect": {
      "A": [
       "A_50",
       30,
       30,
       "none",
       "tier-enter"
      ],
      "B": [
       "B_HIT",
       25,
       25,
       "none",
       "hit"
      ],
      "log": "AB",
      "dispatch": "AB"
     },
     "note_log": "③ 血量跌破 50%：A 通道切到 50% 档，同时再受击一次"
    },
    {
     "tick": 800,
     "sample": {
      "health": 2400
     },
     "expect": {
      "A": null,
      "B": [
       "B_NONE",
       0,
       0,
       "none",
       "pulse-end"
      ],
      "log": "B",
      "dispatch": "B",
      "extra": {
       "n": 1,
       "dt": 500
      }
     }
    },
    {
     "tick": 900,
     "sample": {
      "health": 1450
     },
     "expect": {
      "A": [
       "A_30",
       40,
       40,
       "none",
       "tier-enter"
      ],
      "B": [
       "B_HIT",
       25,
       25,
       "none",
       "hit"
      ],
      "log": "AB",
      "dispatch": "AB"
     },
     "note_log": "④ 血量跌破 30%：A 通道切到 30% 档，同时再受击一次"
    },
    {
     "tick": 1200,
     "sample": {
      "health": 1450
     },
     "expect": {
      "A": null,
      "B": [
       "B_NONE",
       0,
       0,
       "none",
       "pulse-end"
      ],
      "log": "B",
      "dispatch": "B"
     }
    },
    {
     "tick": 1300,
     "sample": {
      "health": 0,
      "doomed": true
     },
     "expect": {
      "A": [
       "A_DOOM",
       60,
       60,
       "none",
       "tier-enter"
      ],
      "B": null,
      "log": "A",
      "dispatch": "A"
     },
     "note": "doomed 上升沿：静默重基线，1450 → 0 的跳变不得产生受击",
     "note_log": "⑤ 泰坦进入濒死：A 通道切到濒死档"
    },
    {
     "tick": 1400,
     "sample": {
      "health": 0,
      "doomed": true
     },
     "expect": {
      "A": null,
      "B": null,
      "log": "",
      "dispatch": ""
     }
    }
   ],
   "once": true
  },
  {
   "id": "S2-termination-then-death-screen",
   "note": "被处决：动画期间保持濒死档输出（不静音）→ 死亡界面触发 E（45×5000ms）→ 复活 → 重新上机",
   "steps": [
