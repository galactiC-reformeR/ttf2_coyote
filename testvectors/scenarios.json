    {
     "tick": 2600,
     "sample": {
      "m25": true
     },
     "expect": {
      "A": null,
      "B": [
       "E_DEATH",
       45,
       45,
       "none",
       "death-screen"
      ],
      "log": "B",
      "dispatch": "B"
     },
     "note": "去抖门槛满足：开窗 + 死亡序列（E 起振）",
     "note_log": "④ 死亡界面确认：B 通道给一次 45 强度、5 秒的死亡脉冲"
    },
    {
     "tick": 2700,
     "sample": {
      "m25": true,
      "alive": false,
      "health": 999999
     },
     "expect": {
      "A": null,
      "B": null,
      "log": "",
      "dispatch": ""
     },
     "note": "窗口内丢弃垃圾读数；E 不中断、不产生受击"
    },
    {
     "tick": 7300,
     "sample": {
      "inTitan": false,
      "alive": true,
      "doomed": false,
      "m25": false,
      "health": 100,
      "maxHealth": 100
     },
     "expect": {
      "A": null,
      "B": null,
      "log": "",
      "dispatch": ""
     },
     "note": "复活为铁驭（doomed 必须一并清掉）；窗口尚未关闭"
    },
    {
     "tick": 7600,
     "expect": {
      "A": null,
      "B": [
       "B_NONE",
       0,
       0,
       "none",
       "pulse-end"
      ],
      "log": "B",
      "dispatch": "B",
      "extra": {
       "dur": 5000
      }
     },
     "note": "E 到期 = 2600 + 5000（纯时间到点，与本帧读数无关）",
     "note_log": "⑤ 死亡脉冲 5 秒到期"
    },
    {
     "tick": 7900,
     "sample": {
      "inTitan": false,
      "alive": true,
      "health": 100,
      "maxHealth": 100
     },
     "expect": {
      "A": [
       "A_NONE",
       0,
       0,
       "none",
       "no-titan"
      ],
      "B": null,
      "log": "A",
      "dispatch": ""
     },
     "note": "inTitan=false 持续 600ms ≥ 500ms → 关窗 + 重基线",
     "note_log": "⑥ 已弹射出来（不在泰坦内）：A 通道归零"
    },
    {
     "tick": 9000,
     "sample": {
      "epoch": 2,
      "inTitan": true,
      "alive": true,
      "health": 5000,
      "maxHealth": 5000
     },
     "expect": {
      "A": [
       "A_NONE",
       0,
       0,
       "none",
       "idle"
      ],
      "B": null,
      "log": "A",
      "dispatch": ""
     },
     "note_log": "⑦ 换上新泰坦：恢复待机"
    }
   ],
   "once": true
  },
